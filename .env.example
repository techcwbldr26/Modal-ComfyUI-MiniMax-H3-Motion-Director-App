# Your Modal account credentials (`modal token new`; `modal profile current` to verify)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# HuggingFace token (Xet transfer backend) — needed for Comfy-Org/MiniMax-H3 downloads
HF_TOKEN=

# Director ComfyUI endpoint (filled after `modal deploy comfyui_director_serve.py`).
# NO LLM VARS — Motion Director is pure ComfyUI, no model provider needed.
DIRECTOR_URL=https://<YOUR-WORKSPACE>--comfyui-director-serve-....modal.direct
